# byte-level noise and sandbox caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynpy_cache/
.venv/
venv/
.DS_Store

# large derived rasters stay in the external cache, never in git
*.npy
*.npy.tmp
/home/user/datacache/

# scratch experiment output that is not an evidence artifact
out/*.npy
out/*.tmp
*.swp

# the submission raster, its receipt and the run card ARE deliverables:
