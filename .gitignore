# Large inputs are restored by scripts/fetch_3dep.py + .github/workflows/dem-fetch.yml, not committed.
data/training_features.tif
data/geodawn_dem_a2_100m.tif
data/tmp_stack/
*.part
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
build/
out/
tmp/
.DS_Store
*.egg-info/
data/raw/
data/*.tif
data/*.npy
